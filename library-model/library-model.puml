 @startuml
skinparam classAttributeIconSize 0
hide circle

abstract class Member {
  - memberNumber : String
  - name : String
  - email : String
  + {abstract} maxLoans() : Integer
  + canBorrow() : Boolean
}

class StudentMember {
  - level : String
  + maxLoans() : Integer
}

class TeacherMember {
  - department : String
  + maxLoans() : Integer
}

class Loan {
  - loanDate : Date
  - dueDate : Date
  - returnDate : Date [0..1]
  + isLate() : Boolean
}

class Copy {
  - inventoryNumber : String
  - status : CopyStatus
  + isAvailable() : Boolean
}

class Book {
  - isbn : String
  - title : String
  - year : Integer
}

class Author {
  - name : String
}

class Reservation {
  - date : Date
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  LOST
}

Member <|-- StudentMember
Member <|-- TeacherMember
Member "1" -- "0..*" Loan
Loan "0..*" -- "1" Copy
Copy "0..*" -- "1" Book
Book "1..*" -- "1..*" Author
Member "1" -- "0..*" Reservation
Reservation "0..*" -- "1" Book
@enduml